{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 160
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "updatedDate": {
      "type": "string",
      "format": "date-time"
    },
    "author": {
      "default": "Sal Castoro",
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "keywords": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "heroImage": {
      "type": "string"
    },
    "heroImageAlt": {
      "type": "string"
    },
    "ogImage": {
      "type": "string"
    },
    "ogImageAlt": {
      "type": "string"
    },
    "metaTitle": {
      "type": "string"
    },
    "canonicalURL": {
      "type": "string",
      "format": "uri"
    },
    "noindex": {
      "default": false,
      "type": "boolean"
    },
    "nofollow": {
      "default": false,
      "type": "boolean"
    },
    "readingTime": {
      "type": "number"
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "twitterCard": {
      "default": "summary_large_image",
      "type": "string",
      "enum": [
        "summary",
        "summary_large_image"
      ]
    },
    "relatedPosts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "series": {
      "type": "string"
    },
    "seriesOrder": {
      "type": "number"
    },
    "estimatedReadingTime": {
      "type": "number"
    },
    "wordCount": {
      "type": "number"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description",
    "pubDate"
  ]
}