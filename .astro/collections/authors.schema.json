{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "bio": {
      "type": "string",
      "maxLength": 160
    },
    "longBio": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "social": {
      "type": "object",
      "properties": {
        "twitter": {
          "type": "string"
        },
        "github": {
          "type": "string"
        },
        "linkedin": {
          "type": "string"
        },
        "instagram": {
          "type": "string"
        },
        "youtube": {
          "type": "string"
        },
        "mastodon": {
          "type": "string"
        }
      }
    },
    "title": {
      "type": "string"
    },
    "company": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "expertise": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "languages": {
      "default": [
        "en"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "showInAuthorsList": {
      "default": true,
      "type": "boolean"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "joinDate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "lastActive": {
      "type": "string",
      "format": "date-time"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "bio"
  ]
}