---
import PageLayout from '@/layouts/PageLayout.astro';
import { Image } from 'astro:assets';
import profileImage from '@/assets/images/profile.jpg';

interface SkillGroup {
  name: string;
  /** Heroicons outline path(s) */
  icon: string[];
  /** Tailwind classes for the icon tile */
  tone: string;
  skills: string[];
}

interface Experience {
  title: string;
  company: string;
  period: string;
  location: string;
  description: string[];
  technologies?: string[];
}


const skillGroups: SkillGroup[] = [
  {
    name: 'Frontend',
    icon: ['M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'],
    tone: 'bg-blue-100 text-blue-600 dark:bg-blue-900 dark:text-blue-400',
    skills: ['React', 'TypeScript', 'Next.js', 'Astro', 'Tailwind CSS', 'shadcn/ui', 'Angular', 'SwiftUI'],
  },
  {
    name: 'Backend & Data',
    icon: ['M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2'],
    tone: 'bg-green-100 text-green-600 dark:bg-green-900 dark:text-green-400',
    skills: ['Node.js', 'Hono', 'Express', 'Fastify', 'Go', 'Python', '.NET Core', 'REST APIs', 'PostgreSQL', 'MSSQL', 'MongoDB'],
  },
  {
    name: 'Cloud & DevOps',
    icon: ['M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z'],
    tone: 'bg-purple-100 text-purple-600 dark:bg-purple-900 dark:text-purple-400',
    skills: ['AWS', 'Cloudflare Workers', 'Azure', 'GitHub Actions', 'Azure DevOps', 'Docker', 'CI/CD'],
  },
  {
    name: 'AI & Developer Tools',
    icon: ['M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z'],
    tone: 'bg-orange-100 text-orange-600 dark:bg-orange-900 dark:text-orange-400',
    skills: ['Claude Code', 'Cursor', 'GitHub Copilot', 'LangChain.js', 'Agentic workflows', 'Git'],
  },
];

const experiences: Experience[] = [
  {
    title: 'Software Engineer',
    company: 'Avtal',
    period: 'April 2026 - Present',
    location: 'Austin, TX',
    description: [
      'Led and completed the migration of the customer payment portal to a modern stack (React, Hono, TypeScript), improving page load times by up to 27%',
      'Contributed to a custom content authoring system for SMS and email communications while migrating templates from the legacy platform'
    ],
    technologies: ['React', 'TypeScript', 'Hono', 'PostgreSQL']
  },
  {
    title: 'Application Engineer',
    company: 'Great American Insurance Group',
    period: 'April 2023 - April 2026',
    location: 'Remote',
    description: [
      'Led modernization of flagship commercial insurance quoting platform, migrating from legacy systems to React and Node.js/Express, resulting in 30% faster page load times and ~20% reduction in quoting errors reported by brokers',
      'Designed and launched a new multi-coverage insurance product from backend schema to frontend UI, contributing to a 12% increase in broker-submitted quotes in its first quarter',
      'Built robust data synchronization pipelines between modern web platform and legacy ERP systems using microservices architecture; resolved schema and nullability mismatches, reducing manual data correction needs by 80%',
      'Delivered technical presentations to 50+ engineers during company meetings on Redux architecture, agentic coding tools, and AI-assisted workflows',
      'Acted as point of contact for onboarding and mentorship, helping ramp up junior devs and collaborating on complex front-end/back-end challenges'
    ],
    technologies: ['React', 'TypeScript', 'Node.js', 'Express', 'Redux', 'PostgreSQL', 'AWS', 'Microservices']
  },
  {
    title: 'Software Developer',
    company: 'PS Solutions',
    period: 'May 2022 - March 2023',
    location: 'Wilmington, NC',
    description: [
      'Built a PTO request and tracking system in Angular 14 and .NET Core, deployed via Azure',
      'Integrated RingCentral calling functionality into a client CRM using .NET MVC and JavaScript'
    ],
    technologies: ['Angular', 'TypeScript', '.NET Core', '.NET MVC', 'Azure', 'RingCentral API']
  },
  {
    title: 'IT Analyst',
    company: 'Clima Cube Self Storage',
    period: 'January 2021 - April 2022',
    location: 'Hampstead, NC',
    description: [
      'Developed a custom price tracking tool with React and Next.js using TypeScript that increased observability into competitor pricing allowing for frequent rate adjustment'
    ],
    technologies: ['React', 'Next.js', 'TypeScript', 'CSS', 'AWS']
  }
];

---

<PageLayout
  title="About Me"
  description="Sal Castoro is a software engineer at Avtal in Austin, TX. Background, skills, and experience across full-stack web development."
>
  <!-- Hero Section -->
  <section class="py-16 lg:py-20">
    <div class="container">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16 items-center">
        <!-- Profile Photo -->
        <div class="lg:col-span-1 flex justify-center lg:justify-start">
          <div class="relative">
            <div class="w-64 h-64 lg:w-80 lg:h-80 rounded-2xl overflow-hidden shadow-xl">
              <Image
                src={profileImage}
                alt="Professional headshot of Sal Castoro"
                width={320}
                height={320}
                class="w-full h-full object-cover object-[center_30%]"
                loading="lazy"
                densities={[1, 2]}
                format="webp"
                quality={85}
              />
            </div>
            <!-- Decorative elements -->
            <div class="absolute -top-4 -right-4 w-8 h-8 bg-blue-500 rounded-full opacity-20"></div>
            <div class="absolute -bottom-6 -left-6 w-12 h-12 bg-indigo-400 rounded-full opacity-15"></div>
          </div>
        </div>

        <!-- Introduction -->
        <div class="lg:col-span-2">
          <div class="max-w-3xl">
            <h1 class="text-4xl lg:text-5xl font-bold text-gray-900 dark:text-white mb-6 text-balance">
              Hi, I'm Sal 
            </h1>
            <div class="space-y-6">
              <p class="text-xl lg:text-2xl text-gray-600 dark:text-gray-300 leading-relaxed">
                I'm a software engineer with six years of experience building full-stack web applications,
                from commercial insurance quoting platforms to payment portals. I like taking legacy systems
                and turning them into fast, maintainable software.
              </p>
              <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
                I'm currently a software engineer at Avtal in Austin, where I work across the stack with React,
                TypeScript, and Hono. Before that, I spent three years modernizing commercial insurance platforms at
                Great American Insurance Group. I'm always excited to learn new technologies and tackle challenging projects.
              </p>
              <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed">
                Outside of work, I build side projects like RunWalk, my iPhone and Apple Watch run/walk
                training app, play tabletop RPGs, and write about what I learn here on the blog.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Skills Section -->
  <section class="py-16 bg-gray-50 dark:bg-gray-900/50">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Skills & Expertise
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          The languages, frameworks, and tools I use day to day
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
        {skillGroups.map(group => (
          <div class="card">
            <div class="card__body">
              <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-5 flex items-center gap-3">
                <span class={`w-8 h-8 rounded-lg flex items-center justify-center ${group.tone}`}>
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    {group.icon.map(d => (
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={d} />
                    ))}
                  </svg>
                </span>
                {group.name}
              </h3>
              <ul class="flex flex-wrap gap-2" aria-label={`${group.name} skills`}>
                {group.skills.map(skill => (
                  <li class="px-3 py-1.5 rounded-lg text-sm font-medium bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200 border border-gray-200 dark:border-gray-700">
                    {skill}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Experience Section -->
  <section class="py-16">
    <div class="container">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-gray-900 dark:text-white mb-4">
          Professional Experience
        </h2>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          My journey through various roles and the impact I've made along the way
        </p>
      </div>

      <div class="max-w-4xl mx-auto">
        <div class="space-y-8">
          {experiences.map((experience, index) => (
            <div class="relative">
              <!-- Timeline line -->
              {index !== experiences.length - 1 && (
                <div class="absolute left-6 top-16 w-px h-full bg-gray-200 dark:bg-gray-700"></div>
              )}
              
              <div class="flex gap-8">
                <!-- Timeline dot -->
                <div class="shrink-0">
                  <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center shadow-lg">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                </div>

                <!-- Experience content -->
                <div class="flex-1 pb-8">
                  <div class="card">
                    <div class="card__body">
                      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4">
                        <div>
                          <h3 class="text-xl font-semibold text-gray-900 dark:text-white">
                            {experience.title}
                          </h3>
                          <p class="text-lg text-blue-600 dark:text-blue-400 font-medium">
                            {experience.company}
                          </p>
                        </div>
                        <div class="text-sm text-gray-500 dark:text-gray-400 mt-2 sm:mt-0 text-right">
                          <p class="font-medium">{experience.period}</p>
                          <p>{experience.location}</p>
                        </div>
                      </div>
                      
                      <ul class="space-y-2 mb-6">
                        {experience.description.map(item => (
                          <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
                            <div class="w-1.5 h-1.5 bg-blue-600 rounded-full mt-2 shrink-0"></div>
                            {item}
                          </li>
                        ))}
                      </ul>

                      {experience.technologies && (
                        <div class="flex flex-wrap gap-2">
                          {experience.technologies.map(tech => (
                            <span class="tag">
                              {tech}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

</PageLayout>
