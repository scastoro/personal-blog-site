---
// Theme toggle component for dark/light/system mode
---

<button
  data-theme-toggle
  class="theme-toggle"
  aria-label="Toggle theme"
  title="Toggle between light, dark, and system theme"
>
  <!-- Sun icon (light theme active) -->
  <svg
    data-theme-icon="light"
    class="w-5 h-5 hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path
      fill-rule="evenodd"
      d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
      clip-rule="evenodd"
    />
  </svg>

  <!-- Moon icon (dark theme active) -->
  <svg
    data-theme-icon="dark"
    class="w-5 h-5 hidden"
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
  </svg>

  <!-- Monitor icon (system theme active; default before the script runs) -->
  <svg
    data-theme-icon="system"
    class="w-5 h-5"
    fill="currentColor"
    viewBox="0 0 20 20"
    aria-hidden="true"
  >
    <path fill-rule="evenodd" d="M3 5a2 2 0 012-2h10a2 2 0 012 2v8a2 2 0 01-2 2h-2.22l.123.489.804.804A1 1 0 0113 18H7a1 1 0 01-.707-1.707l.804-.804L7.22 15H5a2 2 0 01-2-2V5zm5.771 7H5V5h10v7H8.771z" clip-rule="evenodd" />
  </svg>
  
  <!-- Screen reader status -->
  <span data-theme-status class="sr-only">Current theme: Light</span>
</button>

<script>
  // The header renders this component twice (desktop and mobile), so select every instance.
  const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const html = document.documentElement;
  const themeNames = { light: 'Light', dark: 'Dark', system: 'System' } as const;
  type Theme = keyof typeof themeNames;

  const stored = localStorage.getItem('theme');
  let currentTheme: Theme = stored === 'light' || stored === 'dark' ? stored : 'system';

  function updateTheme(theme: Theme) {
    currentTheme = theme;
    localStorage.setItem('theme', theme);

    const isDark = theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
    html.classList.toggle('dark', isDark);

    const nextTheme: Theme = theme === 'light' ? 'dark' : theme === 'dark' ? 'system' : 'light';
    const label = `Switch to ${themeNames[nextTheme].toLowerCase()} theme`;

    toggles.forEach((toggle) => {
      toggle.querySelectorAll<SVGElement>('[data-theme-icon]').forEach((icon) => {
        icon.classList.toggle('hidden', icon.dataset.themeIcon !== theme);
      });
      const status = toggle.querySelector('[data-theme-status]');
      if (status) status.textContent = `Current theme: ${themeNames[theme]}`;
      toggle.setAttribute('title', label);
      toggle.setAttribute('aria-label', label);
    });
  }

  updateTheme(currentTheme);

  toggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      updateTheme(currentTheme === 'light' ? 'dark' : currentTheme === 'dark' ? 'system' : 'light');

      // Announce theme change to screen readers
      const announcement = document.createElement('div');
      announcement.setAttribute('aria-live', 'polite');
      announcement.setAttribute('aria-atomic', 'true');
      announcement.className = 'sr-only';
      announcement.textContent = `Theme switched to ${themeNames[currentTheme].toLowerCase()}`;
      document.body.appendChild(announcement);
      setTimeout(() => announcement.remove(), 1000);
    });
  });

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (currentTheme === 'system') updateTheme('system');
  });
</script>
