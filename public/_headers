# Workers Static Assets headers. A Content-Security-Policy is added to the "/*" rule in
# dist/_headers at build time by scripts/csp-headers.mjs, which hashes inline scripts.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()

# Pages and their Markdown versions share URLs: a zone URL Rewrite Rule serves the
# .md file when the request's Accept header includes text/markdown.
/
  Vary: Accept

/about/
  Vary: Accept

/blog/*
  Vary: Accept

/index.md
  Vary: Accept

/about.md
  Vary: Accept

/blog.md
  Vary: Accept

/_astro/*
  Cache-Control: public, max-age=31536000, immutable
